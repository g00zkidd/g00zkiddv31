local script = G2L["f7"];
	local LocalizationService = game:GetService("LocalizationService")
	local player = game.Players.LocalPlayer
	local textLabel = script.Parent
	
	-- Converts a 2-letter ISO country code into its Unicode flag emoji
	local function getFlagEmoji(countryCode)
		if not countryCode or #countryCode ~= 2 then return "" end
	
		local firstChar = string.byte(countryCode, 1) - 65 + 0x1F1E6
		local secondChar = string.byte(countryCode, 2) - 65 + 0x1F1E6
	
		return utf8.char(firstChar, secondChar)
	end
	
	-- Get the local player's country code
	local success, countryCode = pcall(function()
		return LocalizationService:GetCountryRegionForPlayerAsync(player)
	end)
	
	if success and countryCode then
		local flagEmoji = getFlagEmoji(countryCode)
		textLabel.Text = string.format("%s %s", countryCode, flagEmoji)
	else
		textLabel.Text = "Country: Unknown"
	end
end;
